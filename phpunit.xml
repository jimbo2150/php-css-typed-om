<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
	bootstrap="vendor/autoload.php"
	cacheDirectory=".phpunit.cache"
	beStrictAboutOutputDuringTests="true"
	displayDetailsOnTestsThatTriggerWarnings="true"
	displayDetailsOnTestsThatTriggerDeprecations="true"
	displayDetailsOnPhpunitDeprecations="true"
	failOnNotice="true"
	failOnWarning="true"
	failOnDeprecation="true"
	failOnPhpunitDeprecation="true"
	failOnIncomplete="true"
	failOnSkipped="true"
	failOnRisky="true">
	<testsuites>
		<testsuite name="Unit">
			<directory>tests/CSSOM</directory>
			<directory>tests/Geometry</directory>
			<directory>tests/Grammar</directory>
			<directory>tests/Parser</directory>
			<directory>tests/Support</directory>
			<directory>tests/TypedOM</directory>
		</testsuite>
		<testsuite name="Security">
			<directory>tests/Security</directory>
		</testsuite>
		<testsuite name="Fuzz">
			<directory>tests/Fuzz</directory>
		</testsuite>
		<testsuite name="WPT">
			<directory>tests/WPT/Suites</directory>
		</testsuite>
	</testsuites>
	<source>
		<include>
			<directory suffix=".php">src</directory>
		</include>
	</source>
	<php>
		<ini name="error_reporting" value="-1"/>
		<ini name="display_errors" value="On"/>
	</php>
</phpunit>
