      "category": "canonicalization",
      "operation": "geometry.matrix.ops",
      "input": {
        "mutable": false,
        "init": [1, 0, 0, 1, 10, 20],
        "steps": [
          { "op": "translate", "args": [5, -5] }
        ]
      },
      "expected": {
        "immutableReceiver": true,
        "receiverCssText": "matrix(1, 0, 0, 1, 10, 20)",
