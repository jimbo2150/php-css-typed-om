  "cases": [
    {
      "id": "css-syntax/tokens/split-ignores-string-and-comment-delimiters",
      "upstream": "css/css-syntax/serialize-consecutive-tokens.html",
      "category": "parsing",
      "operation": "syntax.scanner.split",
      "input": { "action": "splitTopLevel", "source": "a: \"x;y\"; b: /* ; */ c", "delimiter": ";" },
      "expected": { "parts": ["a: \"x;y\"", " b: /* ; */ c"] },
      "status": "pass"
    },
    {
      "id": "css-syntax/tokens/remove-comments-preserves-ident-separation",
      "upstream": "css/css-syntax/serialize-consecutive-tokens.html",
      "category": "serialization",
      "operation": "syntax.scanner.split",
      "input": { "action": "removeComments", "source": "div/*c*/span" },
      "expected": { "value": "div span" },
      "status": "pass"
    },
    {
      "id": "css-syntax/tokens/remove-comments-preserves-cdo-cdc-boundary",
      "upstream": "css/css-syntax/cdc-vs-ident-tokens.html",
      "category": "serialization",
      "operation": "syntax.scanner.split",
      "input": { "action": "removeComments", "source": "<!/*c*/--" },
      "expected": { "value": "<! --" },
      "status": "pass"
    },
    {
      "id": "css-syntax/tokens/bad-string-unescaped-newline-rejected",
      "upstream": "css/css-syntax/serialize-consecutive-tokens.html",
      "category": "error-recovery",
      "operation": "syntax.scanner.split",
      "input": { "action": "isBalanced", "source": "\"line1\nline2\"" },
      "expected": { "balanced": false },
      "status": "pass"
    },
    {
      "id": "css-syntax/tokens/escaped-newline-in-string-allowed",
      "upstream": "css/css-syntax/serialize-consecutive-tokens.html",
      "category": "parsing",
      "operation": "syntax.scanner.split",
      "input": { "action": "isBalanced", "source": "\"line1\\\nline2\"" },
      "expected": { "balanced": true },
      "status": "pass"
    },
    {
      "id": "css-syntax/tokens/unquoted-url-with-whitespace-around-value",
