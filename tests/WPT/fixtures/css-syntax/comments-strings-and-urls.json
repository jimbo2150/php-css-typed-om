      "operation": "syntax.scanner.split",
      "input": { "action": "isBalanced", "source": "url(a b.png)" },
      "expected": { "balanced": false },
      "status": "pass"
    },
    {
      "id": "css-syntax/tokens/quoted-url-with-trailing-comment",
      "upstream": "css/css-syntax/url-whitespace-consumption.html",
      "category": "parsing",
      "operation": "syntax.scanner.split",
      "input": { "action": "findMatchingUrlEnd", "source": "url(\"a.png\" /* ok */)", "openParenOffset": 3 },
      "expected": { "offset": 20 },
      "status": "pass"
    },
    {
      "id": "css-syntax/tokens/unquoted-url-with-escaped-paren",
      "upstream": "css/css-syntax/url-whitespace-consumption.html",
