      "id": "css-typed-om/transform/parse-2d-chain-normalizes-names",
      "upstream": "css/css-typed-om/stylevalue-serialization/cssTransformValue.tentative.html",
      "category": "serialization",
      "operation": "typed-om.transform.parse",
      "input": { "cssText": "translateX(10px) rotate(45deg)" },
      "expected": { "cssText": "translatex(10px) rotate(45deg)", "is2D": true, "length": 2, "componentClasses": ["CSSTranslate", "CSSRotate"] },
      "status": "pass"
    },
