    {
      "id": "cssom/stylesheet/delete-namespace-when-only-prelude-rules-exist",
      "upstream": "css/cssom/deleteRule-namespace.html",
      "category": "canonicalization",
      "operation": "cssom.stylesheet.deleteRule",
      "input": { "initialCss": "@import url(\"a.css\"); @namespace svg url(\"http://www.w3.org/2000/svg\");", "index": 1 },
