  "cases": [
    {
      "id": "cssom/stylesheet/parse-empty",
      "upstream": "css/cssom/CSSStyleSheet-constructable-replace-cssRules.html",
      "category": "parsing",
      "operation": "cssom.stylesheet.parse",
      "input": { "css": "" },
      "expected": { "ruleCount": 0, "cssText": "", "parseErrorsEmpty": true },
      "status": "pass"
    },
    {
      "id": "cssom/stylesheet/parse-style-rule",
      "upstream": "css/cssom/CSSStyleSheet-constructable-replace-cssRules.html",
      "category": "parsing",
      "operation": "cssom.stylesheet.parse",
      "input": { "css": "div { color: green; margin: 4px !important; }" },
      "expected": { "ruleCount": 1, "ruleTypes": [1], "cssText": "div { color: green; margin: 4px !important; }", "parseErrorsEmpty": true, "roundTrip": true },
      "status": "pass"
    },
    {
      "id": "cssom/stylesheet/parse-media-and-supports-grouping",
      "upstream": "css/cssom/CSSGroupingRule-insertRule.html",
      "category": "parsing",
      "operation": "cssom.stylesheet.parse",
      "input": { "css": "@media screen { @supports (display: grid) { .box { display: grid; } } }" },
      "expected": { "ruleCount": 1, "ruleTypes": [4], "parseErrorsEmpty": true, "roundTrip": true },
      "status": "pass"
    },
    {
      "id": "cssom/stylesheet/parse-keyframes-and-page",
      "upstream": "css/cssom/CSSStyleSheet-constructable-replace-cssRules.html",
      "category": "serialization",
      "operation": "cssom.stylesheet.parse",
      "input": { "css": "@keyframes fade { from { opacity: 0; } to { opacity: 1; } } @page :first { margin: 1cm; }" },
      "expected": { "ruleCount": 2, "ruleTypes": [7, 6], "parseErrorsEmpty": true, "roundTrip": true },
      "status": "pass"
    },
    {
      "id": "cssom/stylesheet/insert-rule-default-index",
      "upstream": "css/cssom/insertRule-no-index.html",
      "category": "parsing",
      "operation": "cssom.stylesheet.insertRule",
      "input": { "initialCss": "b { color: blue; }", "rule": "a { color: red; }", "index": 0 },
      "expected": { "returnedIndex": 0, "ruleCount": 2, "cssText": "a { color: red; }\nb { color: blue; }" },
      "status": "pass"
    },
    {
      "id": "cssom/stylesheet/insert-rule-append",
      "upstream": "css/cssom/CSSGroupingRule-insertRule.html",
      "category": "parsing",
      "operation": "cssom.stylesheet.insertRule",
      "input": { "initialCss": "a { color: red; }", "rule": "b { color: blue; }", "index": 1 },
      "expected": { "returnedIndex": 1, "ruleCount": 2, "cssText": "a { color: red; }\nb { color: blue; }" },
      "status": "pass"
    },
    {
      "id": "cssom/stylesheet/insert-rule-into-media-grouping",
      "upstream": "css/cssom/CSSGroupingRule-insertRule.html",
      "category": "parsing",
      "operation": "cssom.stylesheet.insertRule",
      "input": { "initialCss": "@media all { a { color: red; } }", "rule": "b { color: blue; }", "index": 1, "targetRuleIndex": 0 },
      "expected": { "returnedIndex": 1, "ruleCount": 1, "cssText": "@media all { a { color: red; }\nb { color: blue; } }" },
      "status": "pass"
    },
    {
      "id": "cssom/stylesheet/insert-rule-reject-empty",
