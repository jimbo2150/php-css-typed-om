    {
      "id": "cssom/stylesheet/replace-sync-replaces-and-detaches",
      "upstream": "css/cssom/CSSStyleSheet-replace-detach-old-rules.html",
      "category": "canonicalization",
      "operation": "cssom.stylesheet.replaceSync",
      "input": { "initialCss": "a { color: red; }", "nextCss": "b { color: blue; } c { margin: 0; }" },
      "expected": { "ruleCount": 2, "cssText": "b { color: blue; }\nc { margin: 0; }", "oldRuleDetached": true },
      "status": "pass"
    },
    {
      "id": "cssom/stylesheet/replace-sync-recovers-malformed",
      "upstream": "css/cssom/CSSStyleSheet-replace-parse-errors.html",
      "category": "error-recovery",
      "operation": "cssom.stylesheet.replaceSync",
      "input": { "initialCss": "a { color: red; }", "nextCss": "broken; p { color: navy; }" },
      "expected": { "cssText": "p { color: navy; }" },
      "status": "pass"
