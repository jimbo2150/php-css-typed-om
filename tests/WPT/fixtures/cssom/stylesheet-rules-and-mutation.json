      "status": "pass"
    },
    {
      "id": "cssom/stylesheet/insert-rule-out-of-bounds",
      "upstream": "css/cssom/CSSGroupingRule-insertRule.html",
      "category": "error-recovery",
      "operation": "cssom.stylesheet.insertRule",
      "input": { "initialCss": "a { color: red; }", "rule": "b { color: blue; }", "index": 5 },
