    {
      "id": "cssom/stylesheet/delete-namespace-while-style-rule-exists",
      "upstream": "css/cssom/deleteRule-namespace.html",
      "category": "error-recovery",
      "operation": "cssom.stylesheet.deleteRule",
      "input": { "initialCss": "@namespace svg url(\"http://www.w3.org/2000/svg\"); svg|rect { fill: red; }", "index": 0 },
