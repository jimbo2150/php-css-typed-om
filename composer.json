{
    "name": "jimbo2150/php-css-typed-om",
    "description": "PHP implementation of the CSS Object Model (CSSOM) and Typed Object Model (OM).",
    "type": "library",
    "license": "Apache-2.0",
    "autoload": {
        "psr-4": {
            "Jimbo2150\\PhpCssTypedOm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jimbo2150\\PhpCssTypedOm\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Jim Robinson",
            "email": "jimbo2150@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.4"
    },
    "scripts": {
        "test": "./vendor/bin/phpunit",
        "test-wpt": "./vendor/bin/phpunit --testsuite=WPT",
        "wpt-audit": "php tools/wpt-sync.php --audit",
        "test-coverage": "XDEBUG_MODE=coverage ./vendor/bin/phpunit --coverage-text",
        "test-coverage-html": "XDEBUG_MODE=coverage ./vendor/bin/phpunit --coverage-html ./.test/coverage",
        "cs-check": "./vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs-fix": "./vendor/bin/php-cs-fixer fix",
        "stan": "./vendor/bin/phpstan analyse --memory-limit=512M",
        "bench": "XDEBUG_MODE=off php -d opcache.enable_cli=1 benchmarks/bench.php"
    },
    "require-dev": {
        "phpunit/phpunit": "^11|^12",
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.3"
    }
}
